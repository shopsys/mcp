{% extends '@ShopsysAdministration/layout/layout_with_panel.html.twig' %}

{% block title %} - {{ 'Authorize MCP client'|trans }}{% endblock %}

{% block pre_title %}{{ 'Settings'|trans }}{% endblock %}
{% block h1 %}{{ 'Authorize MCP client'|trans }}{% endblock %}

{% block main_content %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ 'Approve MCP access'|trans }}</h3>
        </div>
        <div class="card-body">
            <p>{{ 'This client is requesting access to the Shopsys MCP server with your administrator account.'|trans }}</p>

            <dl class="row">
                <dt class="col-sm-3">{{ 'Client'|trans }}</dt>
                <dd class="col-sm-9">{{ clientRegistration.clientName }}</dd>
            </dl>

            {{ form_start(form) }}
                {{ form_widget(form.approve) }}
                {{ form_widget(form.deny) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
